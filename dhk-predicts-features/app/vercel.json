{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "bom1"
  ],
  "buildCommand": "cp core.js public/core.js",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path((?!(?:backup|sweep)$).*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/sweep",
      "schedule": "50 21 * * *"
    }
  ]
}
