+  (o.sends[pk] = o.sends[pk] || []).push(now); (o.sends[ik] = o.sends[ik] || []).push(now); o.n++;
+  o.codes[pk] = { h: tokHash('otpcode:' + phone + ':' + c), exp: now + OTP_MS, tries: 0 };
+  return { code: c };
+}
+function otpVerify(s, body, now) {
+  s.auth = s.auth || {}; s.sessions = s.sessions || {};
